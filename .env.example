# Docker Compose only. Use the same values for the backend MINIO_ACCESS_KEY
# and MINIO_SECRET_KEY. Keep the real .env file outside Git.
MINIO_ROOT_USER=replace-with-your-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-secret
# Docker app images only (compose.apps.yml): public canonical URL of the site, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=https://replace-with-your-site-domain
